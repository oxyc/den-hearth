# All services are enabled by default. Use a comma-separated subset for a smaller node.
HEARTH_SERVICES=all
HEARTH_PORT=8090
HEARTH_BIND=0.0.0.0
HEARTH_PLATFORM=linux/amd64

# Set this to the stable origin clients use, with no trailing slash. A private LAN HTTP address is the easiest
# Chromecast path; an HTTPS reverse proxy also works. Service URLs live below /scout, /reel, /subs and /remux.
HEARTH_PUBLIC_BASE_URL=

# Keep 0.0.0.0 for direct LAN access. Use 127.0.0.1 when a reverse proxy runs on this host, so port 8090 cannot
# bypass HTTPS. A proxy in another container needs a shared Docker network instead.

# Backed by a Docker volume by default. An absolute host path also works, for example:
# HEARTH_CACHE=/srv/den-hearth/cache

# The published full image is linux/amd64. Apple Silicon can use Docker Desktop's emulation. For an
# ARM64 Raspberry Pi running Scout only, build Dockerfile.scout and set this to den-hearth:scout-local.
# HEARTH_IMAGE=den-hearth:scout-local

# `sh selfhost/init.sh` fills these with random values. SCOUT_REMUX_KEY is the one deliberately shared service
# secret. Keep them backed up; changing or losing a config key invalidates that addon's existing installs.
# REMUX_URL_KEY keeps browser sessions valid over restarts.
SCOUT_CONFIG_KEY=
SCOUT_REMUX_KEY=
REEL_CONFIG_KEY=
SUBS_CONFIG_KEY=
REEL_PLAY_SECRET=
REMUX_URL_KEY=

# 48 MiB of memory and 256 MiB on disk. The disk tier is below /cache/scout and survives replacement.
SCOUT_MEMORY_CACHE_BYTES=50331648
SCOUT_DISK_CACHE_BYTES=268435456

# Rebuildable disk budgets: 4 GiB of trailers, 256 MiB of subtitle artifacts, and 1 GiB of Remux scratch.
REEL_CACHE_MAX_BYTES=4294967296
SUBS_CACHE_MAX_BYTES=268435456
REMUX_SCRATCH_MAX_BYTES=1073741824

# Optional service-specific settings. They do nothing unless that service is selected.
# REEL_TMDB_KEY=

# Off by default in this example because titles/releases may be sensitive in a household log.
LOG_IDENTITY=0
LOG_REQUESTS=1
